# Copy this file to .env and fill in your real key. Never commit .env.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Everything below is optional; the defaults are shown.
# ANTHROPIC_MODEL=claude-sonnet-4-6
# RATE_LIMIT_PER_MINUTE=8
# RATE_LIMIT_PER_DAY=60
# RATE_LIMIT_GLOBAL_PER_HOUR=300
# Set to true only behind a proxy that sets X-Forwarded-For (e.g. Vercel).
# TRUST_PROXY_HEADERS=false
# Only needed if the frontend is hosted on a different domain than the API.
# ALLOWED_ORIGINS=https://your-frontend.example.com
